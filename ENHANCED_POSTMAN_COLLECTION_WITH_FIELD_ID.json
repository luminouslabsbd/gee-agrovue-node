    {
      "name": "🌾 FIELD MANAGEMENT (5 endpoints) - NEW",
      "description": "Field CRUD operations with auto-generated field_id",
      "item": [
        {
          "name": "Create Field (Auto-generates field_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.field_id) {",
                  "        pm.collectionVariables.set('field_id', jsonData.data.field_id);",
                  "        console.log('✅ Field ID saved: ' + jsonData.data.field_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fieldBoundary\": {{fieldBoundary}},\n  \"name\": \"Test Field\",\n  \"crop_type\": \"rice\",\n  \"farm_name\": \"Test Farm\",\n  \"location\": \"Dhaka, Bangladesh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fields",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fields"]
            },
            "description": "Create a new field. Field ID is auto-generated in format: FIELD-YYYYMMDD-XXXXXX"
          }
        },
        {
          "name": "Get All Fields",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{authToken}}", "type": "text"}],
            "url": {
              "raw": "{{baseUrl}}/api/fields?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fields"],
              "query": [
                {"key": "limit", "value": "10"},
                {"key": "offset", "value": "0"}
              ]
            }
          }
        },
        {
          "name": "Get Field by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{authToken}}", "type": "text"}],
            "url": {
              "raw": "{{baseUrl}}/api/fields/{{field_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fields", "{{field_id}}"]
            }
          }
        },
        {
          "name": "Update Field",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}", "type": "text"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Field Name\",\n  \"crop_type\": \"wheat\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/fields/{{field_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fields", "{{field_id}}"]
            }
          }
        },
        {
          "name": "Delete Field",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{authToken}}", "type": "text"}],
            "url": {
              "raw": "{{baseUrl}}/api/fields/{{field_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fields", "{{field_id}}"]
            }
          }
        }
