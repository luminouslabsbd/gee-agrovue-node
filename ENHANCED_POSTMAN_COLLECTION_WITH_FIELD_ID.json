{
  "info": {
    "name": "🚀 Google Earth Engine Agrovue - ENHANCED (Field ID Boundary System)",
    "description": "Complete API collection with Field ID Boundary System - 47 endpoints total. Supports both fieldBoundary and field_id patterns for 58% payload reduction.",
