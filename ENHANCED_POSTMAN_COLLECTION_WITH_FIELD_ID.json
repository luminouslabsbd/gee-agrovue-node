      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "field_id",
      "value": "",
      "type": "string",
      "description": "Auto-populated field_id from field creation"
    },
    {
      "key": "adminEmail",
      "value": "admin@agrovue.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "Admin@123456",
      "type": "string"
    },
    {
